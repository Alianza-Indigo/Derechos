# === Identidad de la organizacion ===
APP_NAME="Derechos Humanos"
APP_PUBLIC_URL="http://localhost:3000"

# === Autenticacion (Auth.js / NextAuth v4) ===
# Genera un secreto: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
# Alias compatible con Auth.js v5; se usa si NEXTAUTH_SECRET esta vacio.
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Contrasena compartida de los usuarios demo (solo entorno de demostracion).
DEMO_PASSWORD="demo-seguro"

# === Super administrador (owner con acceso total) ===
# El seed crea/asegura esta cuenta en cada corrida con rol super_admin (permiso
# "*", sin excepcion). La contrasena se sincroniza con SUPERADMIN_PASSWORD.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Super Administrador"

# === Base de datos (Postgres compatible con Vercel/Neon) ===
DATABASE_URL="postgres://usuario:password@host:5432/derechos?sslmode=require"

# === Multiinquilino: dominio raiz para landing/login por subdominio ===
# Con ROOT_DOMAIN="derechos.org", "alianza.derechos.org" resuelve al inquilino
# "alianza". Sin este valor, el dominio comun muestra la landing de plataforma.
ROOT_DOMAIN=""

# === Archivos y cache (Vercel) ===
BLOB_READ_WRITE_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
KV_REST_API_READ_ONLY_TOKEN=""

# === Cron (retencion de ubicaciones) ===
CRON_SECRET=""

# === Proveedores de IA (opcionales; sin claves el asistente opera en modo local) ===
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Proveedor por defecto cuando un prompt usa `providerKey: "global"`: openai | anthropic | gemini
AI_DEFAULT_PROVIDER="openai"
AI_DEFAULT_MODEL=""
# Habilita fallback automatico al siguiente proveedor con credenciales si el elegido no tiene.
AI_ENABLE_PROVIDER_FALLBACK="false"
